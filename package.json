{
  "name": "test-card",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Generate SMPTE bars, grids, alignment and LED tile test patterns for every physical output in a Resolume advanced output, a Pixel Peeker wall or a Blend Calc array.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve:dist": "python3 scripts/serve-dist.py --dir dist --port 4327",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
